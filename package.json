{
  "name": "@druxt-contrib/decoupled-settings",
  "version": "0.1.0",
  "description": "Bakes Drupal Decoupled Settings into the Nuxt build, per consumer.",
  "keywords": [
    "druxt",
    "module"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/druxt-contrib/decoupled-settings"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "require": "./dist/index.ssr.js",
      "import": "./dist/index.esm.js"
    },
    "./components/*": "./dist/components/*"
  },
  "main": "dist/index.ssr.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "siroc build",
    "build:watch": "siroc build --watch",
    "changeset": "changeset",
    "lint": "eslint --ext .js,.vue src test",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/core": "7.20.2",
    "@babel/preset-env": "7.20.2",
    "@changesets/cli": "2.25.2",
    "@playwright/test": "^1.49.0",
    "@vue/test-utils": "1.3.3",
    "babel-core": "7.0.0-bridge.0",
    "druxt": "0.21.0",
    "esbuild-jest": "0.5.0",
    "eslint": "8.28.0",
    "eslint-plugin-nuxt": "4.0.0",
    "jest": "27.5.1",
    "siroc": "0.16.0",
    "vue-jest": "3.0.7",
    "vue-template-compiler": "2.7.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
